FROM tabulario/spark-iceberg:latest

# Switch to root user for installations
USER root

# Create iceberg user and group if they don't exist
RUN groupadd -r iceberg || true && \
    useradd -r -g iceberg -m -d /home/iceberg iceberg || true

# Install Python, pip, and other dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install sbt via direct download (simpler alternative)
RUN curl -L -o sbt.tgz https://github.com/sbt/sbt/releases/download/v1.9.7/sbt-1.9.7.tgz \
    && tar -xzf sbt.tgz -C /opt \
    && rm sbt.tgz \
    && ln -s /opt/sbt/bin/sbt /usr/local/bin/sbt

# Create symbolic link for python if it doesn't exist
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Upgrade pip
RUN python3 -m pip install --upgrade pip

# Install Jupyter and Apache Toree
RUN pip install jupyter \
    toree \
    pyspark \
    notebook \
    jupyterlab

# Set environment variables for Spark
ENV SPARK_HOME=/opt/spark
ENV PYTHONPATH=$SPARK_HOME/python:$SPARK_HOME/python/lib/py4j-*.zip
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=python3

# Install Toree kernel
RUN jupyter toree install \
    --spark_home=$SPARK_HOME \
    --kernel_name="Spark-Scala" \
    --spark_opts="--master=spark://spark-iceberg:7077 --driver-memory=6g --executor-memory=10g --executor-cores=3 --total-executor-cores=4 --packages org.apache.hadoop:hadoop-aws:3.3.2,com.amazonaws:aws-java-sdk-bundle:1.12.262"

# Install additional kernels for PySpark
RUN jupyter toree install \
    --spark_home=$SPARK_HOME \
    --kernel_name="PySpark" \
    --interpreters=PySpark \
    --spark_opts="--master=spark://spark-iceberg:7077 --driver-memory=6g --executor-memory=10g --executor-cores=3 --total-executor-cores=4 --packages org.apache.hadoop:hadoop-aws:3.3.2,com.amazonaws:aws-java-sdk-bundle:1.12.262"

# Create a directory for notebooks
RUN mkdir -p /home/iceberg/notebooks
WORKDIR /home/iceberg

# Create the entrypoint script that the base image expects
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Function to start Spark Master\n\
start_spark_master() {\n\
    echo "Starting Spark Master..."\n\
    /opt/spark/bin/spark-class org.apache.spark.deploy.master.Master \\\n\
        --host ${SPARK_MASTER_HOST:-0.0.0.0} \\\n\
        --port ${SPARK_MASTER_PORT:-7077} \\\n\
        --webui-port ${SPARK_MASTER_WEBUI_PORT:-8083} &\n\
    \n\
    # Wait for Spark Master to start\n\
    sleep 10\n\
}\n\
\n\
# Function to start Jupyter\n\
start_jupyter() {\n\
    echo "Starting Jupyter Notebook..."\n\
    cd /home/iceberg/notebooks\n\
    jupyter notebook \\\n\
        --ip=0.0.0.0 \\\n\
        --port=8888 \\\n\
        --no-browser \\\n\
        --allow-root \\\n\
        --NotebookApp.allow_origin="*" \\\n\
        --NotebookApp.disable_check_xsrf=True\n\
}\n\
\n\
# Check SPARK_MODE environment variable\n\
if [ "${SPARK_MODE}" = "master" ]; then\n\
    echo "Running in master mode with Jupyter"\n\
    start_spark_master\n\
    start_jupyter\n\
else\n\
    echo "Running original entrypoint for worker mode"\n\
    # Call the original entrypoint if it exists\n\
    if [ -f "/opt/entrypoint.sh" ]; then\n\
        exec /opt/entrypoint.sh "$@"\n\
    else\n\
        # Fallback to default spark behavior\n\
        exec "$@"\n\
    fi\n\
fi\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

# Change ownership to iceberg user for notebooks directory
RUN chown -R iceberg:iceberg /home/iceberg

# Switch back to iceberg user
USER iceberg

# Expose ports
EXPOSE 8888 7077 8083 4040

# Set the entrypoint
ENTRYPOINT ["/entrypoint.sh"]